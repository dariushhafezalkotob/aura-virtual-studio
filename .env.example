# Hugging Face Access Token for ZeroGPU Engine connections
HF_TOKEN=your_hugging_face_token_here
VITE_HF_TOKEN=your_hugging_face_token_here

# Google Gemini key. With this set, RoomBake textures and scene images are generated on the
# server and nobody needs a key in their browser.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: only needed if you want the OpenAI image provider in RoomBake.
OPENAI_API_KEY=
