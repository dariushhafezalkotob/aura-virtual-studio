{
  "name": "aura-virtual-stage",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run build:server",
    "preview": "vite preview",
    "build:server": "node scripts/build-server.mjs",
    "typecheck": "tsc && tsc -p tsconfig.server.json",
    "start": "node dist-server/prod.mjs",
    "backup:data": "node scripts/backup-data.mjs",
    "db:start": "mkdir -p .mongo/data && .mongo/bin/mongod --dbpath .mongo/data --port 27017 --bind_ip 127.0.0.1 --fork --logpath .mongo/mongod.log && echo \"mongod running on 127.0.0.1:27017\"",
    "db:stop": ".mongo/bin/mongod --dbpath .mongo/data --shutdown || true",
    "user:add": "node scripts/build-server.mjs >/dev/null && node dist-server/user-add.mjs"
  },
  "dependencies": {
    "@gradio/client": "^1.13.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "mongodb": "^7.6.0",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "three": "^0.173.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/qrcode-generator": "^0.0.16",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.173.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.25.12",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
